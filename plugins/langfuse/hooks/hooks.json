{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet \"${CLAUDE_PLUGIN_ROOT}\"/hooks/langfuse_hook.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/babysitter_spawn_tripwire.sh"
          }
        ]
      }
    ]
  }
}
